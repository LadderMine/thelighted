# Backend API base URL (must include the /api prefix backend/src/main.ts sets)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.IO base URL. Defaults to NEXT_PUBLIC_API_URL with a trailing /api
# stripped, since Socket.IO namespaces (e.g. /orders) live on the bare host.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Diner checkout (issue #315) — must match the backend's STELLAR_NETWORK
# (see backend/.env.example) so wallet signature requests and the Stellar
# Explorer link both target the right network.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# USDC issuer account for this network. There is no single well-known USDC
# issuer across every Stellar network/environment (testnet issuers in
# particular are not standardized) — set this explicitly rather than
# guessing. Leaving it unset disables USDC checkout; XLM checkout still
# works, since XLM is the native asset and needs no issuer or trustline.
NEXT_PUBLIC_USDC_ASSET_ISSUER=
